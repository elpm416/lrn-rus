{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lesson",
  "description": "One lesson for the Learning Russian player. Lives at lessons/<id>/lesson.json, next to its images.",
  "type": "object",
  "required": ["id", "title", "images", "sentences", "quiz"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "Must match the folder name and the entry in lessons/index.json.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": { "$ref": "#/$defs/ruEn" },
    "icon": {
      "description": "Built-in icon shown on the lesson card.",
      "enum": ["leaf", "house", "pot", "paw", "snowflake", "sun", "star", "book", "calendar", "ball", "moon"]
    },
    "color": {
      "description": "Card colour.",
      "enum": ["orange", "blue", "yellow", "green", "teal", "purple"]
    },
    "images": {
      "description": "Pictures used by sentences, keyed by a short name.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["file", "alt"],
        "properties": {
          "file": { "description": "File name inside this lesson's folder.", "type": "string" },
          "alt": { "description": "Short description of the picture.", "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "en", "image"],
        "properties": {
          "text": {
            "description": "Russian sentence. Mark syllable breaks with | (Бел|ка). Stress marks (бе́лка) are allowed; they are shown but not spoken.",
            "type": "string"
          },
          "en": { "description": "English translation.", "type": "string" },
          "image": { "description": "Key from images.", "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "words": {
      "description": "Meanings shown in the tap-a-word popup. Keys: lowercase, no punctuation, no stress marks.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "quiz": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "prompt", "options", "answer"],
        "properties": {
          "type": { "description": "Question format. Only 'choice' exists so far.", "enum": ["choice"] },
          "prompt": { "$ref": "#/$defs/ruEn" },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "text": { "type": "string" },
                "image": { "description": "Optional picture file inside this lesson's folder.", "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "answer": { "description": "Index (from 0) of the correct option. Options are shuffled on screen.", "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ruEn": {
      "type": "object",
      "required": ["ru", "en"],
      "properties": { "ru": { "type": "string" }, "en": { "type": "string" } },
      "additionalProperties": false
    }
  }
}
